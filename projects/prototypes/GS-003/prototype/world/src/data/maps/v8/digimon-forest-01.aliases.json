  "look": {
    "id": "v8",
    "doc": "grade escuro/frio no chão e nas copas, luzes pontuais aditivas, névoa na borda da mata, partículas, sombra de contato, zoom x1,5",
    "prefix": "fp8_",
    "zoomMul": 1.5,
    "grade": {
      "description": "How a renderer can reproduce this exact shift procedurally on an existing forest-v4/v6/v7 ground or foliage sprite/tile, instead of re-baking every asset: convert each opaque pixel to HSV, multiply saturation and value by the ground/foliage multipliers below (ground/decor/foliage layers ONLY -- never characters, UI, or this pack's own emissive props), convert back to RGB. For a flat (non-ramped) sprite, treat its lightest ~12% of pixels by value as the \"rim highlight\" and use the gentler rimHighlight multipliers on those instead, so sunlit edges keep reading as lit.",
      "groundFoliageSaturationMul": 0.64,
      "groundFoliageValueMul": 0.8,
      "rimHighlightSaturationMul": 0.88,
      "rimHighlightValueMul": 0.92,
      "accentSaturationMul": 1,
      "scopeNote": "Apply only to ground/decor/foliage layers. Never multiply characters, UI, or this pack's emissive props/lights -- their saturation being untouched is the contrast the study asked for.",
      "rules": [
        {
          "match": "^fp8_(data_crystal|mushroom_bioluminescent|data_totem|lantern_post|campfire_small)$",
          "skip": true
        },
        {
          "match": "^fp8_npc_",
          "skip": true
        },
        {
          "match": "^fp8_ground_variant_",
          "saturationMul": 0.78,
          "valueMul": 0.6
        },
        {
          "match": "^fp8_cliff_",
          "saturationMul": 0.8,
          "valueMul": 0.8,
          "tint": "#6c5a86",
          "tintMix": 0.3
        },
        {
          "match": "^fp4_path_",
          "saturationMul": 0.55,
          "valueMul": 0.74,
          "tint": "#5e4a62",
          "tintMix": 0.28
        },
        {
          "match": "^fp8_",
          "saturationMul": 0.85,
          "valueMul": 0.74
        },
        {
          "match": "^fp7_(npc_|chest|sign)",
          "skip": true
        },
        {
          "match": "^fp6_(healing_point|chest|sign)",
          "skip": true
        },
        {
          "match": "^fp4_flower_cluster|^fp7_flower_digital|^fp7_mushroom_digital",
          "saturationMul": 0.9,
          "valueMul": 0.85
        },
        {
          "match": "^fp7_wg_c16_|^water",
          "saturationMul": 0.7,
          "valueMul": 0.78,
          "hueShift": 8
        }
      ],
      "coolShift": 0.06
    },
    "lights": {
