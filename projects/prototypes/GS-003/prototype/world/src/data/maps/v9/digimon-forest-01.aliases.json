        "radius": 48,
        "intensity": 0.7,
        "oy": -38
      }
    },
    "_npcKeysDoc": "Props que são corpo de NPC humano (26×33, mesmo pipeline dos Tamers v3): o renderer desenha pelo caminho do Tamer (pivô do preset, escala, tratamento noturno, respiração parada), não pelo de prop.",
    "npcKeys": [
      "fp8_npc_ranger",
      "fp8_npc_merchant"
