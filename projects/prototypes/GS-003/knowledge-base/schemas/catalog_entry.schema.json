{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "kb/catalog_entry",
 "title": "Entrada do catálogo mestre (DigimonDex)",
 "type": "object",
 "required": [
  "id",
  "name",
  "names",
  "level",
  "attribute",
  "debut",
  "links",
  "in_etapa4_database",
  "priority",
  "record_status",
  "identity_status",
  "origin_indexes",
  "last_checked"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^sp\\.[a-z0-9_]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "page_title": {
   "type": [
    "string",
    "null"
   ]
  },
  "names": {
   "type": "object",
   "required": [
    "ja_kana",
    "dub_en",
    "alternatives",
    "dub_en_variants"
   ],
   "properties": {
    "ja_kana": {
     "type": [
      "string",
      "null"
     ]
    },
    "dub_en": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "alternatives": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "dub_en_variants": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "level": {
   "type": "object",
   "required": [
    "normalized",
    "en_official",
    "status",
    "source_id",
    "accessed_at"
   ],
   "properties": {
    "normalized": {
     "type": [
      "string",
      "null"
     ]
    },
    "en_official": {
     "type": [
      "string",
      "null"
     ]
    },
    "status": {
     "enum": [
      "verified_primary",
      "verified_secondary",
      "reused_unverified",
      "unverified",
      "pending",
      "inference",
      "missing",
      "verified_metadata"
     ]
    },
    "original_status": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "accessed_at": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "attribute": {
   "type": "object",
   "required": [
    "normalized",
    "en_official",
    "status",
    "source_id",
    "accessed_at"
   ],
   "properties": {
    "normalized": {
     "type": [
      "string",
      "null"
     ]
    },
    "en_official": {
     "type": [
      "string",
      "null"
     ]
    },
    "status": {
     "enum": [
      "verified_primary",
      "verified_secondary",
      "reused_unverified",
      "unverified",
      "pending",
      "inference",
      "missing",
      "verified_metadata"
     ]
    },
    "original_status": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "accessed_at": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "type_en_official": {
   "type": [
    "string",
    "null"
   ]
  },
  "debut": {
   "type": "object",
   "required": [
    "year",
    "media"
   ],
   "properties": {
    "year": {
     "type": [
      "integer",
      "null"
     ]
    },
    "media": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "links": {
   "type": "object",
   "required": [
    "wikimon",
    "visual_list_image_file",
    "refbook_en"
   ],
   "properties": {
    "wikimon": {
     "type": [
      "string",
      "null"
     ]
    },
    "visual_list_image_file": {
     "type": [
      "string",
      "null"
     ]
    },
    "refbook_en": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "in_etapa4_database": {
   "type": "boolean"
  },
  "priority": {
   "enum": [
    "P0",
    "P1",
    "P2",
    "P3",
    "unassigned"
   ]
  },
  "record_status": {
   "enum": [
    "imported_index",
    "enriched_p0",
    "enriched"
   ]
  },
  "identity_status": {
   "enum": [
    "verified_primary",
    "verified_secondary",
    "reused_unverified",
    "unverified",
    "pending",
    "inference",
    "missing",
    "verified_metadata"
   ]
  },
  "origin_indexes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "last_checked": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "profile_file": {
   "type": "string"
  }
 },
 "additionalProperties": false
}